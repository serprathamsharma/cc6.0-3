# Copy to .env, fill in credentials, then run npm run dev.
# Restart npm run dev after changing this file. Secrets stay server-side.
# Cloudinary server-side credentials (optional for local-only uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI vision provider (required for Analyze with OpenAI)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Explicit illustrative simulation when OpenAI is unconfigured or returns 429.
# Results are always labelled SIMULATED_ANALYSIS, never live OpenAI results.
MOCK_VISION=false

# Optional frontend API origin for a separately hosted server (no secrets)
# VITE_API_URL=http://127.0.0.1:8787

# API port; the Vite frontend proxy reads the same value
PORT=8787
