{
  "name": "impactlens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run server\" \"npm run client\"",
    "client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "server": "node server.mjs",
    "dev:all": "npm run dev",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs tests/**/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react-swc": "^4.0.0",
    "cloudinary": "^2.11.0",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.540.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.1.3"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.2"
  }
}
